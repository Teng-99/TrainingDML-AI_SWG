<p class="Sourcecode"><a name="_4e1aef74-9f88-85ce-752a-caa1afc0d0b0" id="_4e1aef74-9f88-85ce-752a-caa1afc0d0b0"></a><span class="p">{</span><span class="w"><br/>&#xA0; </span><span class="nl">"type"</span><span class="p">:</span><span class="w"> </span><span class="s2">"AI_ClassBalanceDegree"</span><span class="p">,</span><span class="w"><br/>&#xA0; </span><span class="nl">"measure"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0; </span><span class="nl">"measureDescription"</span><span class="p">:</span><span class="w"> </span><span class="s2">"Balance degree of label classes"</span><span class="w"><br/>&#xA0; </span><span class="p">},</span><span class="w"><br/>&#xA0; </span><span class="nl">"evaluationMethod"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"><br/>&#xA0;&#xA0;&#xA0; </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"evaluationMethodDescription"</span><span class="p">:</span><span class="w"> </span><span class="s2">"Counting the number of training samples belonging to each class and calculating the balance degree"</span><span class="w"><br/>&#xA0;&#xA0;&#xA0; </span><span class="p">}</span><span class="w"><br/>&#xA0; </span><span class="p">],</span><span class="w"><br/>&#xA0; </span><span class="nl">"result"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"><br/>&#xA0;&#xA0;&#xA0; </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"quantitativeResult"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"value"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="mf">93.5</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">],</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"valueUnit"</span><span class="p">:</span><span class="w"> </span><span class="s2">"%"</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">}</span><span class="w"><br/>&#xA0;&#xA0;&#xA0; </span><span class="p">}</span><span class="w"><br/>&#xA0; </span><span class="p">]</span><span class="w"><br/></span><span class="p">}</span></p>

