<p class="Sourcecode"><a name="_44fd7d2a-b845-6570-c7c1-a5871c3ab29e" id="_44fd7d2a-b845-6570-c7c1-a5871c3ab29e"></a><span class="err">a)</span><span class="w"> </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"level"</span><span class="p">:</span><span class="w"> </span><span class="s2">"dataset"</span><span class="p">,</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"levelDescription"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"dataset"</span><span class="p">:</span><span class="w"> </span><span class="s2">"whu_rs19"</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">}</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">]</span><span class="w"><br/>&#xA0;&#xA0; </span><span class="p">}</span><span class="w"><br/></span><span class="err">b)</span><span class="w"> </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"level"</span><span class="p">:</span><span class="w"> </span><span class="s2">"attribute"</span><span class="p">,</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"levelDescription"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"attributes"</span><span class="p">:</span><span class="w"> </span><span class="s2">"completeness"</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">}</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">]</span><span class="w"><br/>&#xA0;&#xA0; </span><span class="p">}</span><span class="w"><br/></span><span class="err">c)</span><span class="w"> </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"level"</span><span class="p">:</span><span class="w"> </span><span class="s2">"coverage"</span><span class="p">,</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"extent"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"geographicElement"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"westBoundLongitude"</span><span class="p">:</span><span class="w"> </span><span class="mf">-171.76409</span><span class="p">,</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"eastBoundLongitude"</span><span class="p">:</span><span class="w"> </span><span class="mf">-157.86768</span><span class="p">,</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"southBoundLatitude"</span><span class="p">:</span><span class="w"> </span><span class="mf">-14.42443</span><span class="p">,</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"northBoundLatitude"</span><span class="p">:</span><span class="w"> </span><span class="mf">21.31573</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">}</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">]</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">}</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">]</span><span class="w"><br/>&#xA0;&#xA0; </span><span class="p">}</span><span class="w"><br/></span><span class="err">d)</span><span class="w"> </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"level"</span><span class="p">:</span><span class="w"> </span><span class="s2">"feature"</span><span class="p">,</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"extent"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"geographicElement"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"polygon"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"exterior"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"LinearRing"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0