<p class="Sourcecode"><a name="_cfb85db4-2308-4bab-0698-b6fef3fa2d98" id="_cfb85db4-2308-4bab-0698-b6fef3fa2d98"></a><span class="p">{</span><span class="w"><br/>&#xA0; </span><span class="nl">"type"</span><span class="p">:</span><span class="w"> </span><span class="s2">"AI_ObjectLabel"</span><span class="p">,</span><span class="w"><br/>&#xA0; </span><span class="nl">"class"</span><span class="p">:</span><span class="w"> </span><span class="s2">"Truck"</span><span class="p">,</span><span class="w"><br/>&#xA0; </span><span class="nl">"object"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0; </span><span class="nl">"type"</span><span class="p">:</span><span class="w"> </span><span class="s2">"Feature"</span><span class="p">,</span><span class="w"><br/>&#xA0;&#xA0;&#xA0; </span><span class="nl">"properties"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"truncated"</span><span class="p">:</span><span class="w"> </span><span class="mf">0.0</span><span class="p">,</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"occluded"</span><span class="p">:</span><span class="w"> </span><span class="mi">0</span><span class="p">,</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"alpha"</span><span class="p">:</span><span class="w"> </span><span class="mf">-1.57</span><span class="w"><br/>&#xA0;&#xA0;&#xA0; </span><span class="p">},</span><span class="w"><br/>&#xA0;&#xA0;&#xA0; </span><span class="nl">"geometry"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span class="nl">"type"</span><span class="p">:</span><span class="w"> </span><span class="s2">"Polygon"</span><span class="p">,</span><span class="w"><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; </span><span cla